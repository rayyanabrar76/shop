generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  adminTheme   String   @default("system")
  createdAt    DateTime @default(now())
  stores       Store[]
}

model Store {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  subdomain      String   @unique
  currency       String   @default("USD")
  // Where the shop trades from. Drives the address defaults at checkout, which
  // otherwise showed American examples to a shop selling in rupees.
  country        String   @default("")
  customDomain   String?  @unique
  domainVerified Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Billing / subscription
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?   // trialing | active | past_due | canceled | incomplete
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  // Storage usage tracking (bytes)
  storageUsed BigInt @default(0)

  owner           User              @relation(fields: [ownerId], references: [id])
  products        Product[]
  orders          Order[]
  reviews         ProductReview[]
  customers       Customer[]
  theme           StoreTheme?
  categories      Category[]
  payment         StorePayment?
  customSections  CustomSection[]
  media           MediaAsset[]
  pages           StorePage[]
  storeCustomers  StoreCustomer[]
  discountCodes   DiscountCode[]
  shippingRates   ShippingRate[]
  aiSuggestions   AiSuggestion[]
  subscribers     NewsletterSubscriber[]
  policies        StorePolicy[]
}

/**
 * A shop's written policies: refund, privacy, terms, shipping, contact.
 *
 * These used to be ordinary StorePage rows, indistinguishable from About Us,
 * which meant nothing knew they were policies: the checkout linked to none of
 * them and the footer could only hide one by it being blank. They are a fixed,
 * known set, so they get a table of their own, one row per kind per shop, and
 * the checkout and footer read them by kind.
 *
 * `content` starts empty. A policy is a promise to real customers and nobody
 * should ship one the merchant did not write or at least read; the editor
 * offers a draft, it does not publish one.
 */
model StorePolicy {
  id        String   @id @default(cuid())
  storeId   String
  /// refund | privacy | terms | shipping | contact
  kind      String
  title     String
  content   String   @default("")
  /// Whether the storefront footer lists it. The checkout always links a
  /// written terms and privacy policy, since those are the ones an order
  /// agrees to.
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind])
}

enum Plan {
  FREE
  BASIC
  PRO
}

model StorePayment {
  id      String @id @default(cuid())
  storeId String @unique

  codEnabled      Boolean @default(false)
  stripeAccountId String?
  stripeEnabled   Boolean @default(false)
  taxEnabled      Boolean @default(false)
  taxRate         Float   @default(0)
  taxName         String  @default("Tax")

  store Store @relation(fields: [storeId], references: [id])
}

model StoreTheme {
  id              String  @id @default(cuid())
  storeId         String  @unique
  primaryColor    String  @default("#0a0a0a")
  backgroundColor String  @default("#ffffff")
  footerColor     String  @default("#ffffff")
  accentColor     String  @default("#000000")
  textColor       String  @default("#0a0a0a")
  font            String  @default("sans")
  headingFont     String  @default("serif")
  baseFontSize    Int     @default(16)
  bannerText      String  @default("Welcome to our store")
  showBanner      Boolean @default(true)
  logoUrl         String?
  logoWidth       Int     @default(120)
  logoHeight      Int     @default(48)  // caps header height for tall logos
  headerLayout    String  @default("left")  // left | centered
  footerLogoUrl    String  @default("")   // blank = reuse the header logo
  footerLogoWidth  Int     @default(130)
  footerLogoHeight Int     @default(56)

  // Header layout + appearance
  menuPosition      String  @default("auto")      // auto | left | center | right
  headerWidth       String  @default("page")      // page | full
  headerHeight      String  @default("standard")  // compact | standard | tall
  headerSticky      Boolean @default(true)
  headerBorderWidth Int     @default(1)
  headerBgColor     String  @default("")          // blank = translucent white
  headerTextColor   String  @default("")          // blank = inherit
  utilityStyle      String  @default("icons")     // icons | text

  // Transparent header (home page only): the bar sits over the hero instead of
  // above it, and swaps to an inverse logo for contrast.
  headerTransparent     Boolean @default(false)
  headerInverseLogoUrl  String  @default("")
  headerTransparentText String  @default("#ffffff")

  // Add-to-cart button colours. Blank falls back to the grid button colour,
  // which itself falls back to the primary colour.
  cartBtnBgColor   String @default("")
  cartBtnTextColor String @default("")
  cartBtnDisplay   String @default("icon")  // icon | hidden ("always"/"hover" are legacy and render as icon)
  layout          String  @default("grid")  // grid | carousel | editorial ("list" is legacy)
  carouselOnMobile Boolean @default(false)
  borderRadius    String  @default("0px")
  buttonStyle     String  @default("solid")
  cardShadow      String  @default("none")
  dividerStyle    String  @default("none")
  showSearch      Boolean @default(true)
  shopAllLabel    String  @default("Shop All Products")
  /// Whether the button under the grid is drawn at all. Separate from its
  /// label, because a blank label is an unnamed button, not a missing one.
  shopAllShow     Boolean @default(true)
  /// The button's own spacing, in px. Padding is the button; margin is the
  /// room around it inside the grid section.
  shopAllPadTop    Int     @default(12)
  shopAllPadBottom Int     @default(12)
  shopAllPadLeft   Int     @default(32)
  shopAllPadRight  Int     @default(32)
  shopAllMarginTop Int     @default(0)
  shopAllMarginBottom Int     @default(32)
  featuredLabel   String  @default("Featured Products")
  /// Whether the heading above the grid is drawn at all.
  featuredLabelShow Boolean @default(true)
  /// The heading's own spacing, in px.
  featuredLabelPadTop       Int     @default(0)
  featuredLabelPadBottom    Int     @default(0)
  featuredLabelPadLeft      Int     @default(0)
  featuredLabelPadRight     Int     @default(0)
  featuredLabelMarginTop    Int     @default(0)
  featuredLabelMarginBottom Int     @default(28)
  /// How the "shop all" button is drawn. Blank follows the theme's own
  /// button style; "text" drops the frame and leaves the words.
  shopAllStyle    String  @default("")
  featuredLabelLevel String @default("")  // blank keeps the original small-caps label
  productGridBg          String  @default("#ffffff")
  /// The grid section's own spacing, in px. Padding is inside the section,
  /// so its background covers it; margin is outside, so it does not.
  productGridPadTop       Int     @default(24)
  productGridPadBottom    Int     @default(24)
  productGridPadLeft      Int     @default(0)
  productGridPadRight     Int     @default(0)
  productGridMarginTop    Int     @default(0)
  productGridMarginBottom Int     @default(0)
  productImageRadius     String  @default("")  // blank = follow global borderRadius
  productGridButtonColor String  @default("")
  productGridTextColor   String  @default("")
  productGridFont        String  @default("")
  productsPageHeading    String  @default("")
  productTitleWidth      String  @default("fill")
  productTitleMaxWidth   String  @default("")
  productTitleAlign      String  @default("left")
  productTitlePreset     String  @default("default")
  productTitleBg         String  @default("")
  productTitlePaddingTop    Int  @default(4)
  productTitlePaddingBottom Int  @default(0)
  productTitlePaddingLeft   Int  @default(0)
  productTitlePaddingRight  Int  @default(0)
  productPricePreset     String  @default("h6")
  productPriceWidth      String  @default("fit")
  productPriceAlign      String  @default("left")
  productPriceTextColor  String  @default("")
  productPricePaddingTop    Int  @default(0)
  productPricePaddingBottom Int  @default(0)
  productPricePaddingLeft   Int  @default(0)
  productPricePaddingRight  Int  @default(0)
  /// Cards without a price. Some shops quote rather than sell, and some
  /// price by weight at the counter, so the number is the wrong thing to
  /// put on the card.
  productPriceHidden     Boolean @default(false)
  cartBtnLabel       String  @default("")
  /// The quick-add chip's corners. Blank is a full pill, which is what it
  /// was before this was settable, so existing shops do not move.
  cartBtnRadius      String  @default("")
  cartBtnShowIcon    Boolean @default(true)
  cartBtnWidth       String  @default("fill")
  cartBtnFontSize    Int     @default(10)
  cartBtnPaddingTop    Int   @default(5)
  cartBtnPaddingBottom Int   @default(5)
  cartBtnPaddingLeft   Int   @default(0)
  cartBtnPaddingRight  Int   @default(0)
  customCss              String  @default("")
  customHead             String  @default("")
  footerText      String?

  // ── Search engines & the browser tab ──────────────────────────────────
  // seoTitle is the whole <title> for the home page, not a suffix, so a shop
  // can rank on a phrase rather than just its own name. Blank = store name.
  seoTitle       String @default("")
  seoDescription String @default("")
  // A square mark for the tab. The header logo is usually wide and turns to
  // mush at 32px, so it is only the fallback.
  faviconUrl     String @default("")

  // Order of the reorderable home page sections, as comma-separated keys:
  // "hero", "products", and "custom:<id>". Blank means the default order.
  // Anything missing from the list is appended, so a newly added section
  // still shows up without having to rewrite this.
  sectionOrder   String @default("")

  // ── Footer ────────────────────────────────────────────────────────────
  footerNewsletter        Boolean @default(true)
  footerNewsletterHeading String  @default("")
  footerNewsletterText    String  @default("")
  // Blank uses the store's own pages; these are for shops that keep their
  // policies somewhere else entirely.
  footerShowLinks         Boolean @default(true)
  instagramHandle String?
  twitterHandle   String?
  facebookUrl     String?
  heroSlides      Json?
  navLinks        Json?
  /// The mobile drawer's contents. One column rather than a scalar per
  /// row, because the drawer gains a block whenever someone thinks of
  /// another one. Shape lives in src/lib/drawer.ts.
  drawer          Json?
  navFontSize     Int     @default(14)
  navCase         String  @default("normal")
  navDividers     Boolean @default(false)
  darkMode        Boolean @default(false)
  showDarkToggle  Boolean @default(true)
  // Category filter / products page
  catBackLabel         String  @default("Back to store")
  catFilterRadius      String  @default("9999px")
  catFilterFontSize    Int     @default(12)
  catFilterFont        String  @default("")
  catFilterCase        String  @default("uppercase")
  catFilterActiveBg    String  @default("")
  catFilterActiveText  String  @default("#ffffff")
  catFilterInactiveBg  String  @default("")
  catFilterInactiveText String @default("")
  catFilterPaddingX    Int     @default(16)
  catFilterPaddingY    Int     @default(6)
  catBackFont          String  @default("")
  catFilterFontWeight  String  @default("bold")

  store Store @relation(fields: [storeId], references: [id])
}

model CustomSection {
  id          String   @id @default(cuid())
  storeId     String
  pageId      String?
  name        String
  layout      String
  heading     String?
  text        String?
  imageUrl    String?
  buttonLabel   String?
  buttonUrl     String?
  buttonVariant String?
  buttonRadius  String?
  buttonColor   String?
  buttonFont    String?
  showButton    Boolean @default(false)
  // Shop-by-category: comma-separated Category ids. Blank shows every category.
  categoryIds   String  @default("")
  showCount     Boolean @default(false)
  bgColor       String?
  position    Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

model StorePage {
  id        String   @id @default(cuid())
  storeId   String
  type      String
  name      String
  slug      String
  content   Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  fileId    String
  filename  String
  type      String   // "image" | "video"
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int
  inventory   Int
  imageUrl    String?
  status      String   @default("DRAFT")
  category    String?
  sku         String?
  // Search keywords, used for on-site search and SEO keywords. Postgres text[].
  tags        String[] @default([])
  // URL slug, e.g. /products/classic-glazed. Nullable so existing rows stay
  // valid until backfilled; lookups fall back to the id for old links.
  slug        String?
  // What Google shows. Blank falls back to the title and description, which
  // is right most of the time: these exist for the cases where the shop
  // name reads well on the page but badly in a result list.
  seoTitle       String?
  seoDescription String?
  // Describes the main image for screen readers and image search. An
  // uploaded file is usually called something like 08367.png, which tells
  // neither a reader nor a crawler anything.
  imageAlt       String?
  createdAt   DateTime @default(now())
  storeId     String

  store      Store                @relation(fields: [storeId], references: [id])
  orderItems OrderItem[]
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    ProductReview[]

  @@unique([storeId, slug])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  total           Int
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerCity    String?
  customerCountry String?
  paymentMethod   String?
  stripeSessionId String?
  notes           String?
  discountCode    String?
  discountAmount  Int         @default(0)
  shippingAmount  Int         @default(0)
  shippingMethod  String?
  taxAmount       Int         @default(0)
  /** When the review request went out, so it goes out once and no more. */
  reviewRequestedAt DateTime?

  store Store       @relation(fields: [storeId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Int
  variantLabel String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  // Per-image description, same purpose as Product.imageAlt.
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductVariantOption[]
}

model ProductVariantOption {
  id            String  @id @default(cuid())
  variantId     String
  label         String
  priceOverride Int?
  inventory     Int     @default(0)
  sku           String?
  position      Int     @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  name      String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
}

model StoreCustomer {
  id           String   @id @default(cuid())
  storeId      String
  email        String
  passwordHash String?
  googleId     String?
  name         String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store     Store                  @relation(fields: [storeId], references: [id])
  addresses StoreCustomerAddress[]

  @@unique([storeId, email])
}

model StoreCustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  name       String?
  line1      String
  line2      String?
  city       String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer StoreCustomer @relation(fields: [customerId], references: [id])
}

model StorePasswordReset {
  id         String   @id @default(cuid())
  storeId    String
  email      String
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model DiscountCode {
  id        String    @id @default(cuid())
  storeId   String
  code      String
  type      String    // "percentage" | "fixed"
  value     Int       // percentage (0-100) or fixed cents
  minOrder  Int       @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, code])
}

model ShippingRate {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  price         Int      // cents, 0 = free
  minOrder      Int      @default(0)
  estimatedDays String?
  createdAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

/**
 * A customer's rating of a product.
 *
 * Kept as first-party data rather than an embedded widget because the whole
 * point is the aggregateRating in the page's structured data, and Google only
 * counts a rating that is actually rendered on the page it marks up.
 *
 * Reviews arrive PENDING. An open form on the public internet collects spam,
 * and a shop cannot un-publish something a crawler has already read, so the
 * merchant sees it before anyone else does.
 */
model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  storeId     String
  authorName  String
  /** Never shown publicly. Used to match the review to an order. */
  authorEmail String?
  /** 1 to 5. Validated at the API, since Prisma has no range constraint. */
  rating      Int
  title       String?
  body        String?
  status      ReviewStatus @default(PENDING)
  /** The shop's public answer. Shown under the review on the storefront. */
  reply       String?
  repliedAt   DateTime?
  /** The email placed an order in this shop containing this product. */
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id])

  // The storefront always asks for one product's published reviews, and the
  // admin always asks for one store's pending ones.
  @@index([productId, status])
  @@index([storeId, status])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

/// A cached "what should I add next" suggestion.
///
/// Working it out means sending the whole catalogue to a model and waiting a
/// few seconds, which is far too slow to repeat every time a form opens. The
/// fingerprint is a cheap summary of the catalogue: while it matches, the
/// stored answer is still valid and no model call is needed.
model AiSuggestion {
  id          String   @id @default(cuid())
  storeId     String
  kind        String   // "category" | "product"
  fingerprint String
  payload     Json
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, kind])
}

/// Someone who gave their email in the storefront footer.
///
/// Separate from Customer: signing up to hear from a shop is not the same as
/// having bought from it, and conflating the two would put people who never
/// ordered into the customer list.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
  @@index([storeId, createdAt])
}
